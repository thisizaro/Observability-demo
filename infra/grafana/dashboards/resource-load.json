{
  "uid": "resource-load",
  "title": "Resource Load",
  "tags": ["observability-demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Load Active",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "idle" }, "1": { "text": "active" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cpu_load_active",
          "legendFormat": "cpu_load_active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Load Bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "memory_load_bytes",
          "legendFormat": "memory_load_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}
